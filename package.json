{
	"name": "minimalist-audio-recorder",
	"packageManager": "pnpm@10.33.0",
	"version": "0.2.1",
	"description": "A small floating button for recording voice notes into notes that match a folder or tag.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node --env-file-if-exists=.env esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node --env-file-if-exists=.env esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"lint": "eslint .",
		"prepare": "lefthook install"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"audio",
		"recording"
	],
	"author": "Reinny Almonte",
	"license": "MIT",
	"devDependencies": {
		"@commitlint/cli": "^21.2.3",
		"@commitlint/config-conventional": "^21.2.3",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "0.25.5",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"lefthook": "^2.1.14",
		"obsidian": "^1.13.1",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	}
}
